.env
.env.*
*.key
api.txt
secrets/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Data and models (large, regenerable)
data/store/
models/*.bin
models/*.safetensors
*.parquet

# Runtime (bundles, playbooks, transcripts and the spend ledger are copied into logs/ for delivery)
run/
logs/*.jsonl
logs/*.log
!logs/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

