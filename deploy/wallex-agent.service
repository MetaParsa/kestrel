# Main engine. Runs in SHADOW mode (live data, simulated fills) until go-live (C5),
# then ExecStart switches to --mode live — only after the user says "go live".
[Unit]
Description=wallex-agent engine
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=trader
WorkingDirectory=/opt/wallex-agent
EnvironmentFile=/etc/wallex-agent/env
Environment=TZ=Asia/Tehran
ExecStart=/opt/wallex-agent/.venv/bin/python -m engine.run --mode shadow --manager remote --run-dir /opt/wallex-agent/run/main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
