# Main engine. The mode comes from WALLEX_MODE in /etc/wallex-agent/env (shadow until go-live),
# so a redeploy (which re-copies this file) can never switch live trading back to shadow.
[Unit]
Description=wallex-agent engine
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=trader
WorkingDirectory=/opt/wallex-agent
EnvironmentFile=/etc/wallex-agent/env
Environment=TZ=Asia/Tehran
ExecStart=/opt/wallex-agent/.venv/bin/python -m engine.run --mode ${WALLEX_MODE} --manager remote --run-dir /opt/wallex-agent/run/main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
