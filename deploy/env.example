# /etc/wallex-agent/env  (chmod 600, owner trader) — never commit the real file.
WALLEX_KEY_FILE=/etc/wallex-agent/wallex.key
# Contest end, with offset. Unconfirmed default: Torob's deadline.
WALLEX_END_AT=2026-10-23T23:50:00+03:30
BALE_TOKEN=
BALE_CHAT_ID=
# shadow (simulated fills) until go-live; deploy/arm_live.sh switches it — never edit by hand mid-run
WALLEX_MODE=shadow
